# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
.build/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
#coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# mod cache
#go.sum

# Editor/IDE
# .idea/
# .vscode/

#do not leak secrets please
.env

# Actions configuration holds HTTP headers/tokens and must never be committed.
# Use config/actions.yml.example as a template and deploy the real file separately.
config/actions.yml

# Task's fingerprint cache. Committing it makes `task build` (and the lint/test it
# precedes) look up to date on a fresh clone and skip the work entirely.
.task/checksum/

# Local assistant/tooling state (e.g. CommandCode taste notes), not part of the app.
.commandcode/

# Ghostboard attachments live next to ghostboard.json; they are runtime data.
config/data/files/

