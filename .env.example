# Example environment for GoSpin. Copy to `.env` (Docker Compose reads the
# variables below) or export them, and keep the real file out of git.
# Almost every key here also exists in config/config.yaml: the environment wins
# over the file, so an exported value is the last word on a setting.
# `.env` does not support dotted keys: use GO_SPIN_MISC_GIN_MODE, not
# GO_SPIN_MISC.GIN_MODE.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT and WAITING_SERVER_PORT are the Docker-friendly aliases of
# GO_SPIN_SERVER_PORT and GO_SPIN_SERVER_WAITING_SERVER_PORT; either form works,
# and the bare name wins when both are set.
PORT=8084
WAITING_SERVER_PORT=8085
#GO_SPIN_SERVER_PORT=8084
#GO_SPIN_SERVER_WAITING_SERVER_PORT=8085
#GO_SPIN_CONFIG_PATH=./config          # directory holding config.yaml, homepage.yaml and actions.yml
GO_SPIN_SERVER_READ_TIMEOUT_SECS=10
GO_SPIN_SERVER_WRITE_TIMEOUT_SECS=10
GO_SPIN_SERVER_IDLE_TIMEOUT_SECS=120
GO_SPIN_SERVER_SHUTDOWN_TIMEOUT_SECS=5
GO_SPIN_SERVER_REQUEST_TIMEOUT_MILLIS=1000

# Security headers on every response (waiting server included)
GO_SPIN_SERVER_SECURITY_HEADERS_ENABLED=true
#GO_SPIN_SERVER_SECURITY_HEADERS_CSP=  # empty = built-in policy for the shipped UI
#GO_SPIN_SERVER_SECURITY_HEADERS_HSTS_MAX_AGE_SECS=31536000  # only behind HTTPS

# ---------------------------------------------------------------------------
# Data and scheduling
# ---------------------------------------------------------------------------
#GO_SPIN_DATA_FILE_PATH=./config/data/config.json
GO_SPIN_DATA_PERSIST_INTERVAL_SECS=5
GO_SPIN_DATA_SCHEDULING_ENABLED=true
GO_SPIN_DATA_SCHEDULING_POLL_INTERVAL_SECS=30
GO_SPIN_DATA_BASE_URL=http://localhost/
GO_SPIN_DATA_SPIN_UP_URL=http://localhost/
GO_SPIN_DATA_REFRESH_INTERVAL_SECS=60
GO_SPIN_DATA_STATS_REFRESH_INTERVAL_SECS=120
GO_SPIN_DATA_SYSTEM_MONITOR_MOUNT_POINT=/
GO_SPIN_DATA_ACTIONS_MODE=async
GO_SPIN_DATA_ACTIONS_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
GO_SPIN_MISC_GIN_MODE=release
GO_SPIN_MISC_LOG_LEVEL=info
#LOG_LEVEL=debug                      # read by the logger at startup, before the configuration
GO_SPIN_MISC_SCHEDULING_TIMEZONE=Local
GO_SPIN_MISC_RUNTIME_TYPE=docker      # docker or memory (memory needs no Docker socket)
GO_SPIN_MISC_CORS_ALLOWED_ORIGINS=*   # comma-separated origins, or * for all
#GO_SPIN_SERVER_CORS_ALLOWED_ORIGINS=  # deprecated alias, misc.cors_allowed_origins wins
#GO_SPIN_MISC_COSMOS_BASE_URL=https://cosmos.example.com
# Secrets belong in the environment, never in config/config.yaml or in git.
#GO_SPIN_MISC_COSMOS_TOKEN=

# ---------------------------------------------------------------------------
# Ghostboard (shared text boards)
# ---------------------------------------------------------------------------
#GO_SPIN_GHOSTBOARD_FILE_PATH=./config/data/ghostboard.json   # defaults to <dir of data.file_path>/ghostboard.json
GO_SPIN_GHOSTBOARD_CLEAR_DELAY_SECS=300
GO_SPIN_GHOSTBOARD_MAX_TEXT_BYTES=16777216
GO_SPIN_GHOSTBOARD_PERSIST_INTERVAL_SECS=2
GO_SPIN_GHOSTBOARD_HEARTBEAT_INTERVAL_SECS=25

# Private boards: one shared PIN, stored as HMAC-SHA256(pin_secret, pin).
# Print the digest with `gb-cli pin-hash <pin>` and keep the secret out of git.
#GO_SPIN_GHOSTBOARD_PRIVATE_BOARDS=lavoro,note
#GO_SPIN_GHOSTBOARD_PIN_HMAC=
#GO_SPIN_GHOSTBOARD_PIN_SECRET=
GO_SPIN_GHOSTBOARD_SESSION_TTL_SECS=28800
GO_SPIN_GHOSTBOARD_PIN_MAX_ATTEMPTS=5
GO_SPIN_GHOSTBOARD_PIN_LOCKOUT_SECS=60

# Attachments
GO_SPIN_GHOSTBOARD_FILES_ENABLED=true
GO_SPIN_GHOSTBOARD_MAX_FILE_BYTES=838860800
GO_SPIN_GHOSTBOARD_MAX_FILE_COUNT=10
GO_SPIN_GHOSTBOARD_MAX_BOARD_FILE_BYTES=2147483648
GO_SPIN_GHOSTBOARD_MAX_TOTAL_FILE_BYTES=5368709120
GO_SPIN_GHOSTBOARD_FILE_TTL_SECS=86400
GO_SPIN_GHOSTBOARD_FILE_TRANSFER_TIMEOUT_SECS=600

# Sealed boards: the client encrypts, the server keeps an envelope it cannot read.
# The key lives in the link fragment (/ui/sealed/<board>#k=<key>) or in
# GO_SPIN_BOARD_KEY for gb-cli; never put a board key in this file.
GO_SPIN_GHOSTBOARD_SEALED_ENABLED=true
# The tombstone window: how long a burned name keeps answering 410 Gone before
# it frees the board for a new note with the same name.
GO_SPIN_GHOSTBOARD_SEALED_BURN_TOMBSTONE_SECS=86400
